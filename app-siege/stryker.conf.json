{
  "$schema": "https://stryker-mutator.io/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "./vitest.config.ts",
    "project": {
      "testTimeout": 30000
    }
  },
  "coverageAnalysis": "perTest",
  "tsconfigFile": "tsconfig.json",
  "reporters": ["cleartext", "html", "progress"],
  "htmlReporter": {
    "baseDir": "reports/mutation"
  },
  "files": [
    "lib/**/*.ts",
    "proxy.ts"
  ],
  "mutate": [
    "lib/**/*.ts",
    "proxy.ts"
  ],
  "ignoreMethods": [
    "console.*",
    "logger.*"
  ],
  "ignoreMutations": [
    "BooleanSubstitution",
    "StringLiteral",
    "ArrayDeclaration",
    "TemplateLiteral"
  ]
}
